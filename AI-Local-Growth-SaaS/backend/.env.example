# 后端环境变量样例（复制为 .env 后填入真实值；.env 不入库）
# 数据库：默认 SQLite 零依赖；生产切 PostgreSQL：postgresql+asyncpg://user:pwd@host/db
DATABASE_URL=sqlite+aiosqlite:///./app.db
# 生产示例（PostgreSQL，需 asyncpg）：
# DATABASE_URL=postgresql+asyncpg://saas:CHANGE_ME_STRONG@db:5432/growth

# AI / LLM：mock（离线兜底）/ openai / deepseek
# 生产推荐 deepseek；未配置 DEEPSEEK_API_KEY 时自动降级到 mock，仍可离线演示。
LLM_PROVIDER=deepseek
# 通用 OpenAI 兼容 Key（openai provider 使用）
LLM_API_KEY=
# 通用 Base URL（OpenAI 兼容服务可指定；留空则用各 provider 内置默认值）
LLM_BASE_URL=
# DeepSeek 专用 Key（deepseek provider 优先使用；不硬编码）
DEEPSEEK_API_KEY=

# 鉴权：JWT_SECRET 生产务必改成 ≥32 位的随机串
JWT_SECRET=please-change-this-to-a-random-32plus-char-secret
JWT_EXPIRE_MINUTES=1440

# CORS：逗号分隔的允许来源；* 表示全部（生产请显式列出域名，勿用 *）
CORS_ORIGINS=http://localhost:5173,https://your-domain.example.com

# 公开访问基址（用于生成二维码落地页绝对 URL）
PUBLIC_BASE_URL=http://127.0.0.1:8000

# 服务地址（生产建议 0.0.0.0）
APP_HOST=127.0.0.1
APP_PORT=8000
