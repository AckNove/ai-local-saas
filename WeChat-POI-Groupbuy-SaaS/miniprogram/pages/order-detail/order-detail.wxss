.detail { padding: 30rpx; }
.status { font-size: 30rpx; font-weight: 600; }
.amount { color: #ff5000; font-size: 40rpx; font-weight: 700; margin: 12rpx 0; }
.pickup { background:#e8f8ee; color:#07c160; padding:16rpx; border-radius:12rpx; margin:12rpx 0; }
.codes { margin-top: 20rpx; }
.title { font-size: 26rpx; color:#666; margin-bottom: 8rpx; }
.code { background:#fff; border:1rpx dashed #07c160; border-radius:12rpx; padding:20rpx; font-size:34rpx; letter-spacing:2rpx; text-align:center; margin-bottom:12rpx; }
.meta { margin-top: 20rpx; color:#555; font-size:26rpx; }
