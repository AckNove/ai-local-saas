.card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 16rpx;
}
.thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #07c160;
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.info { flex: 1; margin-left: 20rpx; }
.name { font-size: 30rpx; font-weight: 600; }
.price { margin-top: 8rpx; }
.now { color: #ff5000; font-size: 32rpx; font-weight: 700; }
.old { color: #999; font-size: 24rpx; text-decoration: line-through; margin-left: 12rpx; }
.sold { color: #999; font-size: 22rpx; margin-top: 6rpx; }
.buy {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #ff5000; color: #fff; font-size: 28rpx;
  display: flex; align-items: center; justify-content: center;
}
