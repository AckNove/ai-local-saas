# 数据库（SQLite 开发 / PostgreSQL 生产）
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# 鉴权
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# CORS（list[str] 类型，需 JSON 数组格式；开发期放开，生产显式列域名）
CORS_ORIGINS=["*"]

# 服务端口（同机有其他服务占用 8000 时改这里，如 8001/8800）
SERVER_PORT=8000

# Web 后台静态产物目录（单服务部署时由后端托管；留空自动取 ../web-admin/dist）
# 留空 = 分离模式（API 仅，前端经 CORS 独立运行）
WEB_ADMIN_DIST=

# 微信支付 Provider（mock | real）
WECHAT_PAY_PROVIDER=mock
# 地图 POI Provider（mock | real）
MAP_POI_PROVIDER=mock
# 通知 Provider（mock | real）
WECHAT_NOTIFY_PROVIDER=mock

# 微信小程序凭证（留空即走 mock）
WECHAT_APPID=
WECHAT_SECRET=
# 微信支付凭证
WXPAY_MCH_ID=
WXPAY_API_KEY=
WXPAY_CERT_PATH=
# 腾讯地图 Key
MAP_KEY=

# 业务参数
COMMISSION_RATE=0.0
PAY_TIMEOUT_MINUTES=15
VERIFY_CODE_EXPIRE_DAYS=30
SLOT_CAPACITY=20
